# ─── Takio environment variables ────────────────────────────────────────────
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# The MVP runs fully on mock data — all variables below are OPTIONAL and only
# needed when connecting the real backend.

# Supabase (future backend: auth, database, realtime chat)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe (future payments: commission, boost, featured, Pro subscription)
VITE_STRIPE_PUBLIC_KEY=

# Google OAuth (future "Sign in with Google")
VITE_GOOGLE_CLIENT_ID=
